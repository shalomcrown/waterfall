# Version pins shared by install-prereqs.sh and the build scripts.
# When a prerequisite changes, edit this file and the package lists in
# install-prereqs.sh, then re-run ./install-prereqs.sh.

# Linux packages use the distro Qt (apt qt6-base-dev).
# Windows stays on this aqt Qt. Android uses QT_ANDROID_VERSION below, the same
# kit ntpclock builds with, so one install under /opt/qt serves both projects.
QT_VERSION=6.6.3
QT_INSTALL_BASE=/opt/qt
QT_HOST_ARCH=gcc_64
QT_WINDOWS_ARCH=win64_mingw
QT_ANDROID_ARCH=android_arm64_v8a
# Directory names aqt actually creates (not always the same as the arch argument).
QT_HOST_DIRNAME=gcc_64
QT_WINDOWS_DIRNAME=mingw_64
QT_ANDROID_DIRNAME=android_arm64_v8a

# Qt 6.11 ships 16 KB page alignment and supports Android 9 through 16.
# The Android host tools are the matching desktop Qt, arch linux_gcc_64,
# installed beside the Windows 6.6.3 host under QT_INSTALL_BASE.
# https://doc.qt.io/qt-6.11/android.html
QT_ANDROID_VERSION=6.11.3
QT_ANDROID_HOST_ARCH=linux_gcc_64

CMAKE_MIN_VERSION=4.4.0
CMAKE_VERSION=4.4.2
AQTINSTALL_VERSION=3.3.0

# aqt mirror. The default mirror pool sometimes serves bad SSL certs.
# Set AQT_MIRROR to override (e.g. https://mirrors.ocf.berkeley.edu/qt).
AQT_MIRROR=https://mirrors.ocf.berkeley.edu/qt

# Qt 6.11 Android prerequisites:
# https://doc.qt.io/qt-6.11/android-configure-dev-environment.html
ANDROID_SDK_ROOT=/opt/android-sdk
ANDROID_NDK_VERSION=27.2.12479018
# Play compiles and targets this SDK platform. NDK r27's CMake toolchain
# rejects anything above android-35, so the native sysroot is pinned apart.
ANDROID_PLATFORM=android-36
ANDROID_NATIVE_PLATFORM=android-35
ANDROID_BUILD_TOOLS=36.0.0
ANDROID_JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ANDROID_CMDLINE_TOOLS_URL=https://dl.google.com/android/repository/commandlinetools-linux-13114758_latest.zip
